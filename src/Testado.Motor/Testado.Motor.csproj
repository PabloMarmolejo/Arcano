<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Testado.Motor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDFium: lectura, texto con coordenadas y render de páginas -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="158.0.8111" />
    <PackageReference Include="bblanchon.PDFium.Linux" Version="158.0.8111" />
    <!-- Imagen: pintar testados y codificar JPEG -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <!-- OCR -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <!-- Armado del PDF de salida (6.5 cambió de licencia; se fija 6.2.4, MIT) -->
    <PackageReference Include="PdfSharp" Version="6.2.4" />
    <!-- PDFsharp arrastra la 8.0.1, con vulnerabilidades conocidas -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Testado.Motor.Pruebas" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Catalogo\catalogo.json" LogicalName="Testado.Motor.catalogo.json" />
  </ItemGroup>

  <!-- Modelo de idioma de Tesseract: se descarga una vez y viaja con el ensamblado -->
  <PropertyGroup>
    <TessdataDir>$(MSBuildThisFileDirectory)..\..\recursos\tessdata\</TessdataDir>
  </PropertyGroup>

  <Target Name="DescargarTessdata" BeforeTargets="BeforeBuild" Condition="!Exists('$(TessdataDir)spa.traineddata')">
    <DownloadFile SourceUrl="https://github.com/tesseract-ocr/tessdata/raw/main/spa.traineddata" DestinationFolder="$(TessdataDir)" Retries="3" />
  </Target>

  <ItemGroup>
    <Content Include="$(TessdataDir)spa.traineddata" Link="tessdata\spa.traineddata" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
